# Copy to .env and fill in your own key. .env is gitignored - never commit a real key.
#
# A Gemini API key, from https://aistudio.google.com/apikey. The free tier covers this
# feature comfortably (30 requests/minute, 1500/day at time of writing).
GEMINI_API_KEY=

# Optional. Defaults are in app/llm/gemini_client.py.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=minimal      # minimal | low | medium | high, or "none" to omit the key
# GEMINI_TIMEOUT=20
